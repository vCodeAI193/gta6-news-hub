{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless --disable-dev-shm-usage",
        "skipAudits": [],
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo",
          "pwa"
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage",
      "serverBaseUrl": "https://lhci.example.com"
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "metrics:first-contentful-paint": ["error", { "maxValue": 2000 }],
        "metrics:largest-contentful-paint": ["error", { "maxValue": 2500 }],
        "metrics:cumulative-layout-shift": ["error", { "maxValue": 0.15 }],
        "metrics:first-input-delay": ["error", { "maxValue": 200 }],
        "metrics:total-blocking-time": ["error", { "maxValue": 300 }]
      }
    }
  }
}
